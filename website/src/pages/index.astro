---
import "../styles/landing.css";
import logoSvg from "../assets/logo.svg?raw";
const logo = logoSvg.replace(/fill="#111322"/g, "fill=\"currentColor\"");
import { ArrowRight, BookOpen } from "lucide-react";
import GithubIcon from "../components/GithubIcon.astro";
import Doors from "../components/Doors";
import Features from "../components/Features";
import ArchitectureBeams from "../components/ArchitectureBeams";
import CodeTabs from "../components/CodeTabs";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/Abhishek-Rnjn/evalsi";
const doc = (p: string) => `${base}${p}`;

// Search and link previews: the canonical URL, the social card
// (scripts/og-image.mjs) and structured data that ties the site to the
// repository and the PyPI packages, so search engines treat them as one project.
const siteUrl = new URL(`${base}/`, Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
const title = "Evalsi (evalsi) · Open-source evaluation for AI agents, RAG and models, from CI to production to training";
const description = "Evalsi (pip install evalsi) evaluates AI before you ship, while it runs and as you train it: agents on sandboxed tasks, RAG pipelines, LLMs and models, with CI gates, release decisions, live trace scoring, a built-in agent harness and RL rewards on one set of evaluators. Self-hosted, sandboxed, open source.";
// Search Console verification; the same default as astro.config.mjs.
const googleVerification = process.env.GOOGLE_SITE_VERIFICATION || "71Ou0Qy18e2sRbPlZ9OXapiu2-xZAJnnmPcVzmDdetM";
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Evalsi",
  alternateName: "evalsi",
  description,
  url: siteUrl,
  codeRepository: repo,
  programmingLanguage: ["Python", "Go"],
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  sameAs: [repo, "https://pypi.org/project/evalsi/", "https://pypi.org/project/evalsi-harness/"],
  keywords: "agent evaluation, AI agent testing, agent CI gates, agent harness, release decisions, judge calibration, RAG evaluation, RAG faithfulness, RL rewards, fine-tuning evaluation, LLM evaluation, LLM-as-a-judge, G-Eval, JevEval, DeepEval, evals, RL rewards, OpenTelemetry, Kubernetes",
});

const ecosystem = [
  "lm-evaluation-harness", "Inspect AI", "RAGAS", "DeepEval", "SWE-bench", "τ-bench", "Terminal-Bench", "BFCL",
  "LangGraph", "CrewAI", "OpenAI Agents SDK", "LlamaIndex", "Claude Agent SDK", "OpenInference", "OpenLLMetry",
  "MLflow", "OpenTelemetry", "Langfuse", "Phoenix", "agentgateway", "Kubernetes", "KEDA", "NATS",
  "PostgreSQL", "ClickHouse", "S3", "Firecracker", "TRL", "verl", "OpenRLHF", "MCP", "A2A",
  "vLLM", "SGLang", "Ollama",
];

// The hero's product view: `evalsi compare --fail-on-regression` on a
// baseline and a candidate (illustrative numbers, real output format). Each
// paired difference is also drawn as a whisker around zero over [-0.4, 0.4].
const compare = [
  { metric: "task-success", n: 40, base: 0.925, cand: 0.7, diff: -0.225, lo: -0.378, hi: -0.072, verdict: "REGRESSED" },
  { metric: "tool-call-accuracy.recall", n: 40, base: 0.812, cand: 0.846, diff: 0.034, lo: -0.041, hi: 0.109, verdict: "" },
  { metric: "loop-detection", n: 40, base: 0.875, cand: 0.95, diff: 0.075, lo: 0.006, hi: 0.144, verdict: "improved" },
  { metric: "policy-violations.policy-clean", n: 40, base: 0.975, cand: 0.975, diff: 0, lo: -0.049, hi: 0.049, verdict: "" },
];
const WIDTH = 21;
const RANGE = 0.4;
const signed = (v: number) => (v > 0 ? "+" : v < 0 ? "-" : " ") + Math.abs(v).toFixed(3);
const whisker = (r: { diff: number; lo: number; hi: number }) => {
  const at = (v: number) => Math.round(((Math.max(-RANGE, Math.min(RANGE, v)) + RANGE) / (2 * RANGE)) * (WIDTH - 1));
  const [lo, hi, mid, zero] = [at(r.lo), at(r.hi), at(r.diff), at(0)];
  return Array.from({ length: WIDTH }, (_, i): [string, string] =>
    i === mid ? ["●", "mid"] : i === lo || i === hi ? ["│", "in"] : i > lo && i < hi ? ["─", "in"] : i === zero ? ["┊", "zero"] : ["·", "out"]);
};
const tone = (v: string) => (v === "REGRESSED" ? "text-[#ff6369]" : v === "improved" ? "text-teal-300" : "text-[#a3a9b8]");

const tabs = [
  { label: "Agent gate", lang: "yaml", code: `# evalsi run -f agent-gate.yaml    exit 0 passes, exit 3 fails the build
apiVersion: evalsi.dev/v1alpha1
kind: EvalRun
metadata: {name: agent-gate}
spec:
  target:
    agent:
      cli: {command: [my-agent, --task, "{instruction}"]}
  dataset: {path: tasks.jsonl}
  environment:
    checker: {command: [pytest, -q, hidden_tests]}   # the agent never sees it
  evaluators: [{ref: task-success}, {ref: policy-violations}]
  trials: 3
  gates:
    - {metric: task-success.pass^3, min: 0.8}        # 3 passes in a row, on 80% of tasks` },
  { label: "Release decision", lang: "bash", code: `# Can we safely ship this change? exit 0 PASS, 3 BLOCK, 1 INSUFFICIENT
evalsi release policy-hash -f release-policy.yaml      # review, then pin it
evalsi release gate -f release-policy.yaml --policy-sha256 "$POLICY_SHA256" \\
  --server https://evals.example.com --project support \\
  --id release-2026-10-22-attempt-1 \\
  --baseline "$BASELINE_RUN_ID" --baseline-sha256 "$BASELINE_SHA256" \\
  --baseline-commit "$BASELINE_COMMIT" \\
  --spec candidate.yaml --commit "$CANDIDATE_COMMIT" -o decision.json

# Later: re-check the saved decision against its reviewed digest
evalsi release verify decision.json --sha256 "$DECISION_SHA256"` },
  { label: "RAG", lang: "bash", code: `# Retrieval and generation, scored separately
pip install evalsi
evalsi eval --data rag.jsonl --evaluators citation-accuracy      # no judge needed

# With a judge (a model you host, or Claude): where does it break?
evalsi eval --data rag.jsonl \\
  --evaluators faithfulness,answer-relevance,context-precision,context-recall \\
  --judge-model my-judge --judge-base-url http://localhost:8000/v1` },
  { label: "Training", lang: "yaml", code: `# Evaluators as an RL reward for TRL, verl or OpenRLHF
apiVersion: evalsi.dev/v1alpha1
kind: RewardSpec
metadata: {name: math-grpo}
spec:
  components:
    - {ref: format-check, name: format, weight: 0.1}
    - {ref: math-equiv, name: correct, weight: 1.0}
    - ref: overlong-penalty
      name: overlong
      weight: 1.0
      params: {max_length: 4096, buffer: 512}` },
  { label: "Score outputs", lang: "bash", code: `# Install from PyPI and grade outputs you already have
pip install evalsi
evalsi eval --data qa.jsonl \\
  --evaluators exact-match,numeric-match,latency

# Add a judge: any OpenAI-compatible server, or Claude
pip install 'evalsi[anthropic]'
evalsi eval --data qa.jsonl --evaluators llm-judge \\
  --judge-provider anthropic --judge-model claude-opus-5-5` },
  { label: "Python", lang: "python", code: `import evalsi
from evalsi import MetricSpec, Record, Score, ScoreType, evaluator

@evaluator(name="acme/polite", version="1.0.0",
           outputs=[MetricSpec("polite", ScoreType.PASSED, higher_is_better=True)])
def polite(record: Record) -> Score:
    return Score(passed="please" in record.output.as_text().lower())

result = evalsi.evaluate("qa.jsonl", ["exact-match", polite])
print(result.table())
result.save("results.json")` },
  { label: "Trace source", lang: "yaml", code: `apiVersion: evalsi.dev/v1alpha1
kind: TraceSource
metadata:
  name: studio-mlflow
  labels: {evalsi.dev/project: studio}
spec:
  connector: mlflow
  endpoint: https://mlflow.example.com
  locations: [studio-agents]       # experiments
  backfill: {since: 720h}          # 30 days of history first
  policies: [studio-agents]        # score with these online policies
  writeBack: {enabled: true}       # scores become MLflow assessments` },
  { label: "Kubernetes", lang: "yaml", code: `apiVersion: evalsi.dev/v1alpha1
kind: EvalRun
metadata:
  name: swebench-verified
  labels: {evalsi.dev/project: swe}
spec:
  target:
    agent:
      cli: {command: [sh, -c, "my-agent --non-interactive"]}
  dataset: {uri: "swebench://swebench-verified?split=test"}
  evaluators: [{ref: task-success}, {ref: policy-violations}]
  gates: [{metric: task-success, min: 0.3}]` },
];

const tracks = [
  {
    name: "Agents", badge: "Built first",
    text: "Put an agent to work on sandboxed tasks and grade what it did, before it ships and while it runs.",
    points: [
      "A hidden checker grades the end state; evaluators score tool calls, trajectories, loops and policy violations",
      "pass@k and pass^k over trials, and gates that fail the build",
      "Live traces from LangGraph, CrewAI, the OpenAI Agents SDK, LlamaIndex and the Claude Agent SDK",
    ],
    links: [{ label: "Gate an agent in CI", href: "/docs/guides/gate-an-agent-in-ci/" }, { label: "Agent runs", href: "/docs/guides/agent-runs/" }],
  },
  {
    name: "RAG", badge: "",
    text: "Retrieval and generation fail differently, so Evalsi scores them separately and tells you which to fix.",
    points: [
      "context precision and recall for retrieval; faithfulness and answer relevance for generation",
      "citation accuracy needs no judge, and a judge can be a model you host",
      "RAGAS and DeepEval metrics, and a CI gate on your pipeline's recorded answers",
    ],
    links: [{ label: "Evaluate a RAG pipeline", href: "/docs/guides/evaluate-rag/" }, { label: "DeepEval and JevEval", href: "/docs/guides/deepeval/" }],
  },
  {
    name: "Training", badge: "",
    text: "Evaluators become the reward and the regression check while you fine-tune or run RL.",
    points: [
      "Rewards for TRL, verl and OpenRLHF: format, math equivalence, sandboxed code tests and reward models",
      "Every checkpoint compared with the base model, record by record",
      "Regression gates that fail on significant drops",
    ],
    links: [{ label: "Fine-tuning and RL", href: "/docs/guides/fine-tuning/" }, { label: "Examples", href: "/examples/finetuning/" }],
  },
];

// Product position: the one decision Evalsi is built around
// (docs/PRODUCT-STRATEGY.md), and the workflow that answers it.
const workflow = [
  { step: "1", name: "Connect what you run", text: "Point Evalsi at the agent you already have (A2A, MCP, HTTP, a CLI or the built-in harness) and the traces you already keep in OpenTelemetry, MLflow, Phoenix, Langfuse or LangSmith.", href: "/docs/guides/onboarding/" },
  { step: "2", name: "Turn failures into tests", text: "Capture a failing production trace in the failure inbox, approve a redacted expectation, and publish it to a pinned, versioned regression suite in the dataset catalog.", href: "/docs/guides/failure-inbox/" },
  { step: "3", name: "Decide every release", text: "Run the candidate against an explicit baseline under a reviewed policy. The decision is PASS, BLOCK or INSUFFICIENT, saved with its evidence, from the CLI, the browser or a GitHub Action.", href: "/docs/guides/release-decisions/" },
];

const audiences = [
  { name: "Teams shipping production agents", text: "A daily PR check and a debugging loop: run the suite, open the paired cases that changed, and fix the regression before it merges." },
  { name: "Enterprise AI and platform teams", text: "One self-hosted engine with project isolation, OIDC and RBAC, strict hash-chained audit and air-gapped installs, so every team ships against a shared standard." },
  { name: "Model and training teams", text: "The same evaluators as RL rewards and checkpoint checks, and the same agent tasks as Gymnasium, NeMo Gym, OpenEnv and verifiers environments." },
];

// New in 0.4.0 (CHANGELOG.md).
const whatsNew = [
  { name: "Gates on coverage", text: "A mean leaves skipped records out, so a gate on it can pass when most outputs are missing. The skipped-rate and count gates fail that run, and evalsi run warns when a passing gate skipped records.", href: "/docs/guides/gate-an-agent-in-ci/" },
  { name: "Compare two results files", text: "evalsi compare baseline.json candidate.json pairs records and trials, prints each metric's difference with its interval, and can exit 3 on a regression. No server needed.", href: "/docs/guides/onboarding/" },
  { name: "Gates inside pytest", text: "assert_eval runs an evaluation in a test and fails it with the metric table and the failing records; pytest --evalsi-results saves each call's results.", href: "/docs/guides/onboarding/" },
  { name: "Async and HTTP applications", text: "The application starter runs an async callable or an HTTP endpoint, with a timeout and headers from the environment, so a token never appears in a command.", href: "/docs/guides/onboarding/" },
  { name: "Pull-request comment", text: "The GitHub Action can post its metrics-only summary as one comment, updated on each push. A missing permission never changes the gate's outcome.", href: "/docs/guides/onboarding/" },
  { name: "A first-run screen", text: "An empty server shows the commands that send a first run, the root address leads to the UI, and a finished run can be run again.", href: "/docs/guides/web-ui/" },
  { name: "Evaluators that fail loudly", text: "loop-detection finds repeated blocks of calls, regression errors on unparseable outputs, and json-valid refuses NaN. Some results change: see the changelog.", href: "/docs/changelog/" },
  { name: "A tidier CLI", text: "evalsi --help shows the commands to start with and groups the rest; --help-all lists every command.", href: "/docs/get-started/" },
  { name: "Review fixes", text: "Empty datasets exit 1, byte-order marks load, an interval cannot leave [-1, 1], a dataset path no longer reveals which server files exist, and two vulnerable dependencies are bumped.", href: "/docs/changelog/" },
];

// evalsi-harness (docs/guides/built-in-harness.md): what is built.
const harnessCaps = [
  { name: "Tool-calling agent", text: "OpenAI-compatible and Anthropic models with thinking, streaming and prompt caching; bash, file, edit, glob, grep and patch tools; MCP over HTTP and stdio." },
  { name: "Versioned profiles", text: "minimal, standard and code-mode, so a score names the harness it was measured on." },
  { name: "Sub-agents", text: "A delegate tool starts a sub-agent with a clean context; its steps form a tree and its spend comes out of the parent's budget." },
  { name: "Approval gates", text: "Ask before matching tool calls; a scripted approver approves, edits, denies or never answers, and every decision replays exactly." },
  { name: "Users and interruptions", text: "An LLM-simulated user with a persona and goal, and scripted corrections mid-run." },
  { name: "Long runs", text: "Compact, clear-tool-results, fresh-rounds and evidence-state context strategies, compared like any other setting." },
  { name: "Record, replay, resume, fork", text: "Every model call and tool result is logged as it happens; resume a killed trial or fork from step N." },
  { name: "Faults and hooks", text: "Errors, timeouts, malformed output and prompt injection per tool, and Python hooks at each point of the loop." },
  { name: "Grading that resists gaming", text: "Hidden checkers, clean checker isolation, protected files, reward-hacking signals and per-rule state assertions." },
  { name: "Bring your own agent", text: "A2A, MCP, OpenAI Responses, HTTP, or a CLI in the sandbox, with readers for Claude Code, Codex, Gemini CLI and pi." },
  { name: "Benchmarks and matrices", text: "SWE-bench, τ-bench, Terminal-Bench, Harbor and BFCL; harness × model matrices with cost beside the score." },
  { name: "Training environments", text: "Rollouts with step-level rewards and token traces, as Gymnasium, NeMo Gym, OpenEnv and verifiers environments." },
];

const harnessSpec = `# pip install evalsi-harness; evalsi run -f agent-run.yaml
apiVersion: evalsi.dev/v1alpha1
kind: EvalRun
metadata: {name: fix-calc}
spec:
  target: {connector: anthropic, model: claude-opus-5-5}
  dataset: {path: fix-calc.jsonl}
  harness:
    builtin:
      profile: standard
      max_steps: 20
      budget: {usd: 0.50, wall_clock: 5m}
      hooks:
        - python: evalsi_harness.approval:ApprovalGate
          config:
            rules: [{tool: bash, command: "git push*", action: ask}]
            approver: {default: deny}
  environment:
    sandbox: {min_isolation: namespaced, network: deny}
    checker:                       # the agent never sees it
      files: {test_hidden.py: "..."}
      isolation: clean             # a fresh sandbox, outputs only
      outputs: [calc.py]
      command: [python3, test_hidden.py]
  evaluators:
    - {ref: task-success}
    - {ref: denial-respected}
    - {ref: trial-tampering}
  trials: 3
  gates: [{metric: task-success.pass^3, min: 0.5}]`;

const extras = [
  { name: "Trace sources", text: "Score traces kept in MLflow, Phoenix or Langfuse, and write scores back", href: "/docs/guides/trace-sources/" },
  { name: "Agent frameworks", text: "LangGraph, CrewAI, OpenAI Agents, LlamaIndex, Claude Agent SDK", href: "/docs/guides/agent-frameworks/" },
  { name: "Agent harness integration", text: "Online scoring and deploy gates beside your agent harness", href: "/docs/guides/integrate-an-agent-harness/" },
  { name: "Webhooks", text: "Signed events when a run finishes or fails a gate", href: "/docs/guides/webhooks/" },
  { name: "Human annotation", text: "Queues with progress and agreement", href: "/docs/guides/annotation/" },
  { name: "Wasm evaluators", text: "Ship graders as Wasm with a plugin index", href: "/docs/guides/plugins/" },
  { name: "Web UI and workbench", text: "Runs, paired case inspection, release workbench and catalog", href: "/docs/guides/web-ui/" },
  { name: "Enterprise deployment", text: "Topologies, every outbound connection, audit and data erasure", href: "/docs/guides/enterprise-deployment/" },
  { name: "Evaluator validation", text: "Calibrate judges against frozen human labels", href: "/docs/guides/judge-calibration/" },
  { name: "Production failures to tests", text: "Failure inbox, snapshots and the dataset catalog", href: "/docs/guides/failure-inbox/" },
  { name: "Fine-tuning and RL", text: "Rewards and checkpoint regression checks", href: "/docs/guides/fine-tuning/" },
];
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={siteUrl} />
  <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Evalsi" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Evalsi: evaluate AI before you ship, while it runs, and as you train it" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
  <script type="application/ld+json" set:html={jsonLd} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="font-sans">
  <!-- Nav -->
  <header class="sticky top-0 z-50 border-b border-gray-200/60 bg-white/90 backdrop-blur dark:border-white/5 dark:bg-[#05060d]/70">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
      <a href={`${base}/`} aria-label="Evalsi home" class="[&>svg]:h-8 [&>svg]:w-auto" set:html={logo} />
      <nav class="flex items-center gap-1 text-sm text-gray-600 dark:text-gray-400">
        <a class="hidden rounded-lg px-3 py-2 hover:text-gray-900 sm:block dark:hover:text-white" href={doc("/docs/get-started/")}>Docs</a>
        <a class="hidden rounded-lg px-3 py-2 hover:text-gray-900 sm:block dark:hover:text-white" href={doc("/examples/")}>Examples</a>
        <a class="hidden rounded-lg px-3 py-2 hover:text-gray-900 md:block dark:hover:text-white" href={`${base}/#harness`}>Harness</a>
        <a class="hidden rounded-lg px-3 py-2 hover:text-gray-900 md:block dark:hover:text-white" href={doc("/integrations/")}>Integrations</a>
        <a href={repo} class="ml-1 inline-flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-1.5 font-medium text-gray-900 transition-colors hover:border-gray-400 dark:border-white/10 dark:text-white">
          <GithubIcon /> GitHub
        </a>
      </nav>
    </div>
  </header>

  <main class="overflow-x-clip">
    <!-- Hero -->
    <section class="bg-[#f5f7fa] dark:bg-transparent">
      <div class="mx-auto max-w-6xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24">
        <div class="max-w-4xl">
          <a href={doc("/docs/guides/onboarding/")} class="animate-fade-up group inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-900">
            <span class="font-mono text-teal-700">0.4.0</span>
            <span>Coverage gates, local compare and pytest gates</span>
            <ArrowRight className="size-3.5 transition-transform group-hover:translate-x-0.5" />
          </a>
          <h1 class="animate-fade-up mt-6 text-balance text-4xl font-semibold leading-[1.06] tracking-[-0.03em] [animation-delay:60ms] sm:text-6xl">
            Evaluate AI before you ship, while it runs, and as you train it
          </h1>
          <p class="animate-fade-up mt-6 max-w-2xl text-pretty text-lg leading-8 text-gray-600 [animation-delay:120ms] dark:text-gray-400">
            Answer one question for every change: can we safely ship it? Agents, RAG pipelines, LLMs and models on one set of evaluators, with sandboxed runs and CI gates, live trace scoring, release decisions and RL rewards. Built first for agents. Self-hosted, from a laptop to Kubernetes.
          </p>
          <div class="animate-fade-up mt-8 flex flex-wrap items-center gap-3 [animation-delay:180ms]">
            <a href={doc("/docs/get-started/")} class="group inline-flex h-11 items-center gap-2 rounded-lg bg-gray-900 px-5 font-medium text-white transition-colors hover:bg-gray-800 active:scale-[0.98]">Get started <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" /></a>
            <a href={repo} class="inline-flex h-11 items-center gap-2 rounded-lg border border-gray-200 bg-white px-5 font-medium transition-colors hover:border-gray-400 active:scale-[0.98] dark:border-white/10 dark:bg-white/5">
              <GithubIcon /> Star on GitHub
            </a>
          </div>
          <p class="animate-fade-up mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-500 [animation-delay:180ms]">
            <code class="rounded-md border border-gray-200 bg-gray-50 px-2 py-1 font-mono text-[13px] text-gray-700 dark:border-white/10 dark:bg-white/5 dark:text-gray-300">pip install evalsi</code>
            <a class="underline-offset-4 hover:text-gray-900 hover:underline dark:hover:text-white" href={`${repo}/releases/latest`}>Latest release</a>
            <a class="underline-offset-4 hover:text-gray-900 hover:underline dark:hover:text-white" href={doc("/docs/changelog/")}>Changelog</a>
          </p>
        </div>

        <!-- Product view: the release decision the page is about -->
        <figure class="animate-fade-up mt-16 overflow-hidden rounded-2xl border border-black/10 bg-[#0b0d14] text-left shadow-[0_24px_48px_-12px_rgba(11,13,20,0.35)] [animation-delay:240ms]">
          <div class="flex items-center gap-2 border-b border-white/[.08] bg-[#11141c] px-4 py-3">
            <span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span>
            <span class="ml-2 font-mono text-xs text-[#7a8296]">ci · pull request #418</span>
          </div>
          <pre class="overflow-x-auto p-5 font-mono text-[12.5px] leading-[1.7] text-[#a3a9b8] sm:p-6 sm:text-[13px]"><code><span class="text-teal-300">$</span> <span class="text-[#eef0f5]">evalsi compare baseline.json candidate.json --fail-on-regression</span>

<span class="text-[#7a8296]">metric                         n   baseline  candidate  diff    CI                {"-0.4".padEnd(10)}0{"+0.4".padStart(10)}</span>
{compare.map((r) => (<Fragment><span class="text-[#eef0f5]">{r.metric.padEnd(31)}</span>{String(r.n).padEnd(4)}{r.base.toFixed(3).padEnd(10)}{r.cand.toFixed(3).padEnd(11)}<span class={tone(r.verdict)}>{signed(r.diff)}</span>  {`[${signed(r.lo).trim()}, ${signed(r.hi).trim()}]`.padEnd(18)}<span aria-hidden="true">{whisker(r).map(([ch, kind]) => <span class={kind === "out" ? "text-white/15" : kind === "zero" ? "text-white/30" : kind === "mid" ? tone(r.verdict) : r.verdict ? tone(r.verdict) : "text-[#7a8296]"}>{ch}</span>)}</span>  <span class={tone(r.verdict)}>{r.verdict}</span>{"\n"}</Fragment>))}
<span class="text-teal-300">$</span> <span class="text-[#eef0f5]">echo $?</span>
<span class="text-[#ff6369]">3</span></code></pre>
          <figcaption class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-white/[.08] bg-[#11141c] px-5 py-3 text-xs text-[#a3a9b8] sm:px-6">
            <span class="rounded bg-[#ff6369]/15 px-1.5 py-0.5 font-mono text-[#ff6369]">exit 3</span>
            <span>task-success fell by 0.225, and its whole 95% interval is below zero, so the build stops. Improvements inside the noise are not called out.</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Ecosystem -->
    <section class="border-b border-gray-200/70 py-10 dark:border-white/5">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="text-sm text-gray-500">Works with the tools you already use</p>
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-700 dark:text-gray-300">
          {ecosystem.map((e) => <li>{e}</li>)}
        </ul>
      </div>
    </section>

    <!-- Position -->
    <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <p class="text-sm font-medium text-teal-700 dark:text-teal-300">One decision, every change</p>
        <h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Can we safely ship this agent change?</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400">Connect the agent and trace store you already use. Turn real failures into reproducible tests. Get a reviewable release decision for every change, with the evidence behind it.</p>
      </div>
      <ol class="grid gap-4 lg:grid-cols-3">
        {workflow.map((w) => (
          <li>
            <a href={doc(w.href)} class="group flex h-full flex-col rounded-2xl border border-gray-200 p-6 transition-colors hover:border-gray-400 dark:border-white/10">
              <span class="flex size-8 items-center justify-center rounded-lg border border-gray-200 font-mono text-sm text-gray-500 dark:border-white/10">{w.step}</span>
              <h3 class="mt-4 flex items-center justify-between text-lg font-semibold">{w.name}<ArrowRight className="size-4 text-gray-400 transition-transform group-hover:translate-x-1" /></h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-500 dark:text-gray-400">{w.text}</p>
              {w.step === "3" && (
                <p class="mt-auto flex gap-2 pt-5 font-mono text-xs">
                  <span class="rounded bg-teal-700/10 px-1.5 py-0.5 text-teal-800">PASS</span>
                  <span class="rounded bg-red-600/10 px-1.5 py-0.5 text-red-700">BLOCK</span>
                  <span class="rounded bg-gray-100 px-1.5 py-0.5 text-gray-600">INSUFFICIENT</span>
                </p>
              )}
            </a>
          </li>
        ))}
      </ol>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {audiences.map((a) => (
          <div class="rounded-2xl bg-gray-50 p-5 dark:bg-white/[.03]">
            <h3 class="text-sm font-semibold">{a.name}</h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{a.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-sm text-gray-500"><a class="font-medium text-teal-700 underline-offset-4 hover:underline dark:text-teal-300" href={doc("/docs/guides/gate-an-agent-in-ci/")}>Gate an agent in CI</a>: a failing gate and a GitHub Actions workflow, free and offline. Or <a class="font-medium text-teal-700 underline-offset-4 hover:underline dark:text-teal-300" href={doc("/docs/guides/onboarding/")}>start from your own application</a>.</p>
    </section>

    <!-- Doors -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-sm font-medium text-teal-700 dark:text-teal-300">Four doors, one platform</p>
        <h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Run it, watch it, score it, reward it</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400">The same evaluators work in every mode, so a metric means the same thing in CI, in production and in training.</p>
      </div>
      <Doors base={base} client:visible />
    </section>

    <!-- What's new -->
    <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-sm font-medium text-teal-700 dark:text-teal-300">New in 0.4.0</p>
        <h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Gates that catch missing evidence, and a faster first result</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400">Upgrade with <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-sm dark:bg-white/10">pip install -U evalsi evalsi-harness</code>, and the server and charts to the same version. Everything else that changed is in the <a class="font-medium text-teal-700 underline-offset-4 hover:underline dark:text-teal-300" href={doc("/docs/changelog/")}>changelog</a>.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {whatsNew.map((n) => (
          <a href={doc(n.href)} class="group rounded-2xl border border-gray-200 p-5 transition-colors hover:border-gray-400 dark:border-white/10">
            <h3 class="flex items-center justify-between font-semibold">{n.name}<ArrowRight className="size-4 text-gray-400 transition-transform group-hover:translate-x-1" /></h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{n.text}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Tracks -->
    <section class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-sm font-medium text-teal-700 dark:text-teal-300">Built for what you are building</p>
        <h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Agents, RAG and training</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400">Agents come first because that is where evaluation is hardest. RAG and training are first-class too, and every track uses the same evaluators.</p>
      </div>
      <div class="grid gap-4 lg:grid-cols-3">
        {tracks.map((t) => (
          <div class="flex flex-col rounded-2xl border border-gray-200 p-6 dark:border-white/10">
            <div class="flex items-center justify-between">
              <h3 class="text-xl font-semibold">{t.name}</h3>
              {t.badge && <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-white/10 dark:text-gray-300">{t.badge}</span>}
            </div>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">{t.text}</p>
            <ul class="mt-4 space-y-2 text-sm text-gray-600 dark:text-gray-400">
              {t.points.map((p) => (
                <li class="flex gap-3"><span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-gray-300"></span>{p}</li>
              ))}
            </ul>
            <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 pt-2 text-sm font-medium text-teal-700 dark:text-teal-300">
              {t.links.map((l) => (
                <a href={doc(l.href)} class="group inline-flex items-center gap-1">{l.label} <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" /></a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Harness -->
    <section id="harness" class="relative mt-24 border-y border-gray-200/70 bg-gray-50 py-24 dark:border-white/5">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid items-start gap-12 lg:grid-cols-[1fr_1.1fr]">
          <div>
            <p class="text-sm font-medium text-teal-700 dark:text-teal-300">evalsi-harness</p>
            <h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">A built-in agent harness, made for evaluation</h2>
            <p class="mt-4 text-gray-600 dark:text-gray-400">The harness runs an agent on a task in a sandbox, records every model call and tool result, and grades the final state with a checker the agent never sees. Use it to measure a model on a known, versioned agent, or to put your own agent through the same tasks, trials and gates. The tasks double as RL environments.</p>
            <p class="mt-4 text-gray-600 dark:text-gray-400">It is built for evaluation, not for serving agents to users. Bring an agent that serves users over A2A or HTTP, and Evalsi evaluates it.</p>
            <p class="mt-6 flex flex-wrap items-center gap-3 text-sm">
              <code class="rounded-md border border-gray-200 bg-white/60 px-2 py-1 font-mono text-[13px] text-gray-700 dark:border-white/10 dark:bg-white/5 dark:text-gray-300">pip install evalsi-harness</code>
              <a class="text-gray-500 underline-offset-4 hover:text-gray-900 hover:underline dark:hover:text-white" href="https://pypi.org/project/evalsi-harness/">PyPI</a>
            </p>
            <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-teal-700 dark:text-teal-300">
              <a href={doc("/docs/guides/built-in-harness/")} class="group inline-flex items-center gap-1">What the harness provides <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" /></a>
              <a href={doc("/docs/guides/agent-runs/")} class="group inline-flex items-center gap-1">Agent runs guide <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" /></a>
              <a href={`${repo}/blob/main/docs/HARNESS-ROADMAP.md`} class="group inline-flex items-center gap-1">Harness roadmap <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" /></a>
            </div>
          </div>
          <CodeTabs tabs={[{ label: "agent-run.yaml", lang: "yaml", code: harnessSpec }]} client:visible />
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {harnessCaps.map((c) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-white/[.02]">
              <h3 class="font-semibold">{c.name}</h3>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{c.text}</p>
            </div>
          ))}
        </div>
        <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-gray-500">Not built yet, and proposed on the harness roadmap: a model or human approver and an agent that asks for approval on its own, nested and parallel multi-agent topologies, and conversation-level scoring.</p>
      </div>
    </section>

    <!-- Architecture -->
    <section class="relative py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1.3fr]">
        <div>
          <p class="text-sm font-medium text-teal-700 dark:text-teal-300">Fits your stack</p>
          <h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Plug in at either end</h2>
          <p class="mt-4 text-gray-600 dark:text-gray-400">Send traces from any OpenTelemetry source or gateway, or read them from the MLflow, Phoenix or Langfuse you already run, point runs at your own agent over A2A, MCP, HTTP or a CLI, and export results to the dashboards you already watch.</p>
          <ul class="mt-6 space-y-3 text-sm text-gray-600 dark:text-gray-400">
            <li class="flex gap-3"><span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-gray-300"></span>gRPC, gRPC-Web, HTTP/JSON and MCP on one port</li>
            <li class="flex gap-3"><span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-gray-300"></span>Scores written back to MLflow, Langfuse and Phoenix, or exported over OpenTelemetry</li>
            <li class="flex gap-3"><span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-gray-300"></span>No default judge, so nothing is billed by surprise</li>
            <li class="flex gap-3"><span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-gray-300"></span>Judges on Claude, OpenAI or a model you serve on vLLM, SGLang or Ollama</li>
          </ul>
          <a href={doc("/integrations/")} class="group mt-8 inline-flex items-center gap-2 text-sm font-medium text-teal-700 dark:text-teal-300">Explore integrations <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" /></a>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-2 dark:border-white/10 dark:bg-white/[.02]">
          <ArchitectureBeams client:visible />
        </div>
      </div>
    </section>

    <!-- Bento -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-sm font-medium text-teal-700 dark:text-teal-300">Built for production</p>
        <h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Everything an evaluation platform needs</h2>
      </div>
      <Features base={base} />
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {extras.map((x) => (
          <a href={doc(x.href)} class="group rounded-2xl border border-gray-200 p-5 transition-colors hover:border-gray-400 dark:border-white/10">
            <h3 class="flex items-center justify-between font-semibold">{x.name}<ArrowRight className="size-4 text-gray-400 transition-transform group-hover:translate-x-1" /></h3>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{x.text}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Code -->
    <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <p class="text-sm font-medium text-teal-700 dark:text-teal-300">Your way in</p>
        <h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">CLI, Python or Kubernetes</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400">Write an evaluator as a decorated function, run it next to the built-ins, then take the same spec to a cluster as an <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-sm dark:bg-white/10">EvalRun</code> that gates your rollout.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={doc("/examples/")} class="inline-flex items-center gap-2 rounded-lg border border-gray-200 px-5 py-2.5 text-sm font-medium transition-colors hover:border-gray-400 dark:border-white/10">Browse examples <ArrowRight className="size-4" /></a>
          <a href={doc("/integrations/kubernetes/")} class="inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Kubernetes guide</a>
        </div>
      </div>
      <CodeTabs tabs={tabs} client:visible />
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
      <div class="rounded-2xl border border-gray-200 bg-gray-50 px-6 py-16 text-center dark:border-white/10 dark:bg-white/[.02]">
        <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-5xl">Start evaluating in a minute</h2>
        <p class="mx-auto mt-4 max-w-xl text-gray-600 dark:text-gray-400">Open source, self-hosted and air-gappable. Bring your own models, storage, identity and secrets.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={doc("/docs/get-started/")} class="inline-flex h-11 items-center gap-2 rounded-lg bg-gray-900 px-5 font-medium text-white transition-colors hover:bg-gray-800 active:scale-[0.98]">Read the docs <BookOpen className="size-4" /></a>
          <a href={doc("/docs/architecture/")} class="inline-flex h-11 items-center rounded-lg border border-gray-200 bg-white px-5 font-medium transition-colors hover:border-gray-400 active:scale-[0.98] dark:border-white/10 dark:bg-white/5">See the architecture</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-gray-200 dark:border-white/5">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-gray-500 sm:flex-row sm:px-6">
      <div class="flex items-center gap-3"><span class="[&>svg]:h-6 [&>svg]:w-auto" set:html={logo} /><span>Apache-2.0</span></div>
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a class="hover:text-gray-900 dark:hover:text-white" href={doc("/docs/get-started/")}>Docs</a>
        <a class="hover:text-gray-900 dark:hover:text-white" href={doc("/examples/")}>Examples</a>
        <a class="hover:text-gray-900 dark:hover:text-white" href={doc("/integrations/")}>Integrations</a>
        <a class="hover:text-gray-900 dark:hover:text-white" href={doc("/docs/guides/built-in-harness/")}>Harness</a>
        <a class="hover:text-gray-900 dark:hover:text-white" href={doc("/docs/changelog/")}>Changelog</a>
        <a class="hover:text-gray-900 dark:hover:text-white" href={`${repo}/releases`}>Releases</a>
        <a class="hover:text-gray-900 dark:hover:text-white" href={repo}>GitHub</a>
      </nav>
    </div>
  </footer>

</body>
</html>
